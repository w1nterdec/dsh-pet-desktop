{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Pet portable animation pack v1",
  "type": "object",
  "required": ["format", "name", "animations"],
  "properties": {
    "format": { "const": "dsh-pet/pack-v1" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[\\p{L}\\p{N}_-]+$"
          },
          "file": { "type": "string", "minLength": 1, "maxLength": 240 },
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 300,
            "items": { "type": "string", "pattern": "\\.[pP][nN][gG]$" }
          },
          "fps": { "type": "integer", "minimum": 1, "maximum": 30 }
        },
        "oneOf": [
          { "required": ["file"], "not": { "required": ["frames"] } },
          { "required": ["frames", "fps"], "not": { "required": ["file"] } }
        ]
      }
    }
  }
}
